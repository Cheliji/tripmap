<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM：统一依赖版本与模块管理（AGENTS.md 第 4 节） -->
    <groupId>com.tripmap</groupId>
    <artifactId>tripmap</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>tripmap</name>
    <description>Agent 编排旅游行程规划系统</description>

    <modules>
        <module>tripmap-common</module>
        <module>tripmap-dal</module>
        <module>tripmap-tool</module>
        <module>tripmap-poi</module>
        <module>tripmap-graph</module>
        <module>tripmap-server</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.3.5</spring-boot.version>
        <springdoc.version>2.6.0</springdoc.version>
        <swagger.version>2.2.22</swagger.version>
        <!-- 真实外部调用测试标签：默认排除，手动跑集成测试时置空（见 README 运行说明） -->
        <test.excluded.groups>integration</test.excluded.groups>
        <!-- tripmap-poi Excel 读写（脚本专用依赖，见《tripmap-poi功能设计说明书》§6） -->
        <easyexcel.version>3.3.4</easyexcel.version>
        <!-- ORM：MyBatis-Plus（任务 1.2.4 定案，见《tripmap数据库设计说明书》§5），Boot 3 专用 starter -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <!-- ORM 版本统一托管（子模块禁止单独声明版本，AGENTS.md 第 6 节） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Lombok：全模块 provided 引入（版本由 Spring Boot BOM 统一管理），
             普通 POJO/DTO 一律用 @Data/@Builder 消除样板代码，规则见 AGENTS.md 第 6 节 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <!-- 单测默认跳过 @Tag("integration") 的真实外部调用（AGENTS.md 测试约束），
                     手动执行：mvn test "-Dtest=XxxIntegrationTest" "-Dtest.excluded.groups=" -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
