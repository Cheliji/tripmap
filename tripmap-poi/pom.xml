<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tripmap</groupId>
        <artifactId>tripmap</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <!-- 离线 POI 数据加工脚本模块（零 Spring，不参与运行时）。
         唯一实现依据：《tripmap-poi功能设计说明书》；包划分例外见 AGENTS.md 第 4 节。 -->
    <artifactId>tripmap-poi</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 复用高德客户端（AmapClient/限流/重试/异常体系），不重复造轮子 -->
        <dependency>
            <groupId>com.tripmap</groupId>
            <artifactId>tripmap-tool</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Excel 读写（功能一/二/三的阶段交接物，设计说明书 §2） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>
        <!-- open_hours 等 JSON 字段处理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 脚本日志（模块无 Spring，用 simple binding 即可） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
        <!-- 单测与 HTTP 桩（外部调用一律打桩验证，真实调用走手动执行） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 模块内已用 slf4j-simple，排除 starter-test 传递带入的 logback，避免双绑定告警 -->
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
