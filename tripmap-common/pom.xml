<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tripmap</groupId>
        <artifactId>tripmap</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <!-- DTO、枚举、常量、统一返回体、异常、通用工具（零业务依赖） -->
    <artifactId>tripmap-common</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 仅为统一返回体等 DTO 的 @Schema 注解；不提供任何 web 能力，保持零业务依赖 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <!-- 单测引擎：父 POM surefire 的 excludedGroups（integration 标签排除）要求测试引擎在 classpath 上 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
